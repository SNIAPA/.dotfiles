#!/usr/bin/env python3
import subprocess
import os
import re
import sys
import tempfile


def parse_size(size_str):
    m = re.match(r'([\d.]+)\s*(\S+)', size_str.strip())
    if not m:
        return 0
    val, unit = float(m.group(1)), m.group(2).lower()
    multipliers = {
        'b': 1, 'kib': 1024, 'mib': 1024**2, 'gib': 1024**3,
        'kb': 1024, 'mb': 1024**2, 'gb': 1024**3,
    }
    return int(val * multipliers.get(unit, 1))


def parse_pacman_qi():
    result = subprocess.run(['pacman', '-Qi'], capture_output=True, text=True, check=True)
    packages = {}
    for block in result.stdout.split('\n\n'):
        pkg = {}
        for line in block.split('\n'):
            if m := re.match(r'^Name\s+:\s+(.+)', line):
                pkg['name'] = m.group(1).strip()
            elif m := re.match(r'^Installed Size\s+:\s+(.+)', line):
                pkg['size'] = parse_size(m.group(1))
            elif m := re.match(r'^Description\s+:\s+(.+)', line):
                pkg['desc'] = m.group(1).strip()
            elif m := re.match(r'^Depends On\s+:\s+(.+)', line):
                raw = m.group(1).strip()
                if raw == 'None':
                    pkg['depends'] = []
                else:
                    pkg['depends'] = [re.split(r'[><=!]', d)[0] for d in raw.split() if d]
        if pkg.get('name'):
            packages[pkg['name']] = pkg
    return packages


def get_dep_tree(pkg, pkg_db):
    visited = set()
    stack = [pkg]
    while stack:
        p = stack.pop()
        if p in visited:
            continue
        visited.add(p)
        for dep in pkg_db.get(p, {}).get('depends', []):
            if dep not in visited:
                stack.append(dep)
    return visited


def fmt_size(b):
    if b >= 1024**3:
        return f'{b / 1024**3:.1f}GB'
    elif b >= 1024**2:
        return f'{b / 1024**2:.1f}MB'
    else:
        return f'{b / 1024:.0f}KB'


def main():
    pkg_db = parse_pacman_qi()

    result = subprocess.run(['pacman', '-Qe'], capture_output=True, text=True, check=True)
    explicit = [line.split()[0] for line in result.stdout.strip().splitlines() if line]

    lines = []
    for pkg in sorted(explicit):
        tree = get_dep_tree(pkg, pkg_db)
        dep_count = len(tree) - 1
        total_size = sum(pkg_db.get(p, {}).get('size', 0) for p in tree)
        desc = pkg_db.get(pkg, {}).get('desc', '')
        lines.append(f'{pkg}({dep_count} {fmt_size(total_size)}) - {desc}')

    header = (
        '# Remove lines for packages you want to uninstall.\n'
        '# Save and quit  :wq  to proceed, quit without saving  :q!  to abort.\n'
        '#\n'
    )

    with tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False, prefix='pkg-review-') as f:
        tmpfile = f.name
        f.write(header)
        f.write('\n'.join(lines) + '\n')

    original_pkgs = {line.split('(')[0] for line in lines}

    subprocess.run(['nvim', '+4', tmpfile])

    try:
        with open(tmpfile) as f:
            edited_lines = [l.rstrip() for l in f if l.strip() and not l.startswith('#')]
    finally:
        os.unlink(tmpfile)

    edited_pkgs = {line.split('(')[0] for line in edited_lines}
    to_remove = sorted(original_pkgs - edited_pkgs)

    if not to_remove:
        print('Nothing to remove.')
    else:
        print(f'\nPackages to remove ({len(to_remove)}):')
        for pkg in to_remove:
            print(f'  {pkg}')
        sys.stdout.write('\nProceed? [y/N] ')
        sys.stdout.flush()
        if input().strip().lower() == 'y':
            subprocess.run(['paru', '-Rns'] + to_remove)

    input('\nPress Enter to close...')


if __name__ == '__main__':
    main()
